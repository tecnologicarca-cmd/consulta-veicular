# APIBrasil: você também pode configurar Bearer, Device e endpoints pela aba Configurações.
# Em produção pública, defina uma senha administrativa forte no servidor:
# ARCA_SETTINGS_PASSWORD=
# Opcional: chave independente para cifrar credenciais armazenadas.
# Se ausente, a aplicação deriva a chave de DATABASE_URL, que permanece server-side.
# APIBRASIL_SETTINGS_ENCRYPTION_KEY=

# Credenciais opcionais para fallback/configuração direta no ambiente:
# APIBRASIL_BEARER_TOKEN=
# APIBRASIL_DEVICE_TOKEN=
# APIBRASIL_BASE_URL=https://gateway.apibrasil.io/api/v2

# Provedor HTTPS opcional de dados por placa (terceiro verificado pelo operador).
# Quando configurado, POST envia JSON {"placa":"ABC1234"}; GET aceita ?placa= ou {placa} no caminho.
# PUBLIC_PLATE_API_URL=https://seu-provedor.example/consulta/{placa}
# PUBLIC_PLATE_API_METHOD=GET
PUBLIC_PLATE_API_URL=
PUBLIC_PLATE_API_METHOD=POST
DISABLE_PUBLIC_PLATE_API=false

# FIPE API v2 (Parallelum): gratuita por marca, modelo e ano.
# Opcional: token para uma cota ampliada.
# FIPE_API_TOKEN=

# Homologação APIBrasil: quando true, as chamadas de créditos usam dados de
# teste e NÃO são tarifadas. Mantenha false em produção.
APIBRASIL_HOMOLOG=false
